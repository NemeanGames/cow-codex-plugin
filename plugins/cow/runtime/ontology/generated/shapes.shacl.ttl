        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path cont:WorkPacket.requirementIds ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] .

cont:WorkUnitPolicyShape a sh:NodeShape ;
    sh:targetClass cont:WorkUnitPolicy ;
    sh:closed true ;
    sh:property [
        sh:path cont:WorkUnitPolicy.acceptanceUniverse ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path cont:WorkUnitPolicy.frozen ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path cont:WorkUnitPolicy.frozenAt ;
        sh:datatype xsd:dateTime ;
    ] ;
    sh:property [
        sh:path cont:WorkUnitPolicy.policyVersion ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] .

