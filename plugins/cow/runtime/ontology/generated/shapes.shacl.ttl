        sh:path cont:WorkPacket.frozenInterfaceVersion ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path cont:WorkPacket.ownedPaths ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path cont:WorkPacket.ownerRole ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
